http://www.w3.org/1998/Math/MathML\"><mi>G</mi></math></mjx-assistive-mml></mjx-container></span>-invariant, then <span class=\"math inline\"><mjx-container class=\"MathJax\" jax=\"CHTML\" style=\"font-size: 113.1%; position: relative;\" data-tex=\"\\chi = \\chi_{\\rho|_U} +\n\\chi_{\\rho|_W}\"><mjx-math class=\" MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D712 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-msub space=\"4\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D712 TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: -0.176em;\"><mjx-TeXAtom size=\"s\" texclass=\"ORD\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D70C TEX-I\"></mjx-c></mjx-mi><mjx-msub><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c7C\"></mjx-c></mjx-mo><mjx-script style=\"vertical-align: -0.15em;\"><mjx-mi class=\"mjx-i\" size=\"s\"><mjx-c class=\"mjx-c1D448 TEX-I\"></mjx-c></mjx-mi></mjx-script></mjx-msub></mjx-TeXAtom></mjx-script></mjx-msub><mjx-mo class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c2B\"></mjx-c></mjx-mo><mjx-msub space=\"3\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D712 TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: -0.176em;\"><mjx-TeXAtom size=\"s\" texclass=\"ORD\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D70C TEX-I\"></mjx-c></mjx-mi><mjx-msub><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c7C\"></mjx-c></mjx-mo><mjx-script style=\"vertical-align: -0.15em;\"><mjx-mi class=\"mjx-i\" size=\"s\"><mjx-c class=\"mjx-c1D44A TEX-I\"></mjx-c></mjx-mi></mjx-script></mjx-msub></mjx-TeXAtom></mjx-script></mjx-msub></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>χ</mi><mo>=</mo><msub><mi>χ</mi><mrow data-mjx-texclass=\"ORD\"><mi>ρ</mi><msub><mo data-mjx-texclass=\"ORD\" stretchy=\"false\">|</mo><mi>U</mi></msub></mrow></msub><mo>+</mo><msub><mi>χ</mi><mrow data-mjx-texclass=\"ORD\"><mi>ρ</mi><