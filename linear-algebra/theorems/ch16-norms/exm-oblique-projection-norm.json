x-container></span> over unit <span class=\"math inline\"><mjx-container class=\"MathJax\" jax=\"CHTML\" style=\"font-size: 113.1%; position: relative;\" data-tex=\"\\mathbf{v}\"><mjx-math class=\" MJX-TEX\" aria-hidden=\"true\"><mjx-TeXAtom texclass=\"ORD\"><mjx-mi class=\"mjx-b\"><mjx-c class=\"mjx-c1D42F TEX-B\"></mjx-c></mjx-mi></mjx-TeXAtom></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">v</mi></mrow></math></mjx-assistive-mml></mjx-container></span> is <span class=\"math inline\"><mjx-container class=\"MathJax\" jax=\"CHTML\" style=\"font-size: 113.1%; position: relative;\" data-tex=\"\\sqrt{1 + \\lvert x\\rvert^2}\"><mjx-math class=\" MJX-TEX\" aria-hidden=\"true\"><mjx-msqrt><mjx-sqrt><mjx-surd><mjx-mo class=\"mjx-sop\"><mjx-c class=\"mjx-c221A TEX-S1\"></mjx-c></mjx-mo></mjx-surd><mjx-box style=\"padding-top: 0.103em;\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn><mjx-mo class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c2B\"></mjx-c></mjx-mo><mjx-mo class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c7C\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D465 TEX-I\"></mjx-c></mjx-mi><mjx-msup><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c7C\"></mjx-c></mjx-mo><mjx-script style=\"vertical-align: 0.289em;\"><mjx-mn class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn></mjx-script></mjx-msup></mjx-box></mjx-sqrt></mjx-msqrt></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msqrt><mn>1</mn><mo>+</mo><mo data-mjx-texclass=\"OPEN\" fence=\"false\" stretchy=\"false\">|</mo><mi>x</mi><msup><mo data-mjx-texclass=\"CLOSE\" fence=\"false\" stretchy=\"false\">|</mo><mn>2</mn></msup></msqrt></math></mjx-assistive-mml></mjx-container></span>, which over\n<span class=\"math inline\"><mjx-container class=\"MathJax\" jax=\"CHTML\" styl