script\">B</mi></mrow></mrow></msubsup><mo>∈</mo><msub><mi>M</mi><mi>n</mi></msub><mo stretchy=\"false\">(</mo><mi>F</mi><mo stretchy=\"false\">)</mo></math></mjx-assistive-mml></mjx-container></span> with\nentries <span class=\"math display\"><mjx-container class=\"MathJax\" jax=\"CHTML\" style=\"font-size: 113.1%; position: relative;\" display=\"true\" data-tex=\"\n\\bigl([\\beta]_{\\mathcal{B}}^{\\mathcal{B}}\\bigr)_{ij} \\mathrel{:=} \\beta(v_i,\nv_j) .\n\"><mjx-math display=\"true\" style=\"margin-left: 0; margin-right: 0;\" class=\" MJX-TEX\" aria-hidden=\"true\"><mjx-TeXAtom texclass=\"OPEN\"><mjx-mo class=\"mjx-sop\"><mjx-c class=\"mjx-c28 TEX-S1\"></mjx-c></mjx-mo></mjx-TeXAtom><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c5B\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D6FD TEX-I\"></mjx-c></mjx-mi><mjx-msubsup><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c5D\"></mjx-c></mjx-mo><mjx-script style=\"vertical-align: -0.281em; margin-left: 0;\"><mjx-TeXAtom size=\"s\" texclass=\"ORD\"><mjx-TeXAtom texclass=\"ORD\"><mjx-mi class=\"mjx-cal mjx-i\"><mjx-c class=\"mjx-c42 TEX-C\"></mjx-c></mjx-mi></mjx-TeXAtom></mjx-TeXAtom><mjx-spacer style=\"margin-top: 0.18em;\"></mjx-spacer><mjx-TeXAtom size=\"s\" texclass=\"ORD\"><mjx-TeXAtom texclass=\"ORD\"><mjx-mi class=\"mjx-cal mjx-i\"><mjx-c class=\"mjx-c42 TEX-C\"></mjx-c></mjx-mi></mjx-TeXAtom></mjx-TeXAtom></mjx-script></mjx-msubsup><mjx-msub><mjx-TeXAtom texclass=\"CLOSE\"><mjx-mo class=\"mjx-sop\"><mjx-c class=\"mjx-c29 TEX-S1\"></mjx-c></mjx-mo></mjx-TeXAtom><mjx-script style=\"vertical-align: -0.385em;\"><mjx-TeXAtom size=\"s\" texclass=\"ORD\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D456 TEX-I\"></mjx-c></mjx-mi><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D457 TEX-I\"></mjx-c></mjx-mi></mjx-TeXAtom></mjx-script></mjx-msub><mjx-TeXAtom space=\"4\" texclass=\"REL\"><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c3A\"></mjx-c><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo></mjx-TeXAtom><mjx-mi class=\"m