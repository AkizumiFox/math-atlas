>m</mi></mrow></msub><mo stretchy=\"false\">(</mo><mi>F</mi><mo stretchy=\"false\">)</mo></math></mjx-assistive-mml></mjx-container></span> be the\nmatrix with <span class=\"math display\"><mjx-container class=\"MathJax\" jax=\"CHTML\" style=\"font-size: 113.1%; position: relative;\" display=\"true\" data-tex=\"\n(\\boldsymbol{\\Sigma}^{+})_{ii} = \\begin{cases} \\sigma_i^{-1}, & \\sigma_i > 0,\n\\\\ 0, & \\sigma_i = 0, \\end{cases}\n\"><mjx-math display=\"true\" style=\"margin-left: 0; margin-right: 0;\" class=\" MJX-TEX\" aria-hidden=\"true\"><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c28\"></mjx-c></mjx-mo><mjx-msup><mjx-mi class=\"mjx-b\"><mjx-c class=\"mjx-c1D6BA TEX-B\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: 0.413em;\"><mjx-TeXAtom size=\"s\" texclass=\"ORD\"><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2B\"></mjx-c></mjx-mo></mjx-TeXAtom></mjx-script></mjx-msup><mjx-msub><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo><mjx-script style=\"vertical-align: -0.15em;\"><mjx-TeXAtom size=\"s\" texclass=\"ORD\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D456 TEX-I\"></mjx-c></mjx-mi><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D456 TEX-I\"></mjx-c></mjx-mi></mjx-TeXAtom></mjx-script></mjx-msub><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-mrow space=\"4\"><mjx-mo class=\"mjx-s3\"><mjx-c class=\"mjx-c7B TEX-S3\"></mjx-c></mjx-mo><mjx-mtable style=\"min-width: 5.845em;\"><mjx-table><mjx-itable><mjx-mtr><mjx-mtd style=\"text-align: left; padding-right: 0.5em; padding-bottom: 0.1em;\"><mjx-msubsup><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D70E TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: -0.294em; margin-left: 0;\"><mjx-TeXAtom size=\"s\" texclass=\"ORD\"><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2212\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn></mjx-TeXAtom><mjx-spacer style=\"margin-top: 0.18em;\"></mjx-spacer><mjx-mi class=\"mjx-i\" size