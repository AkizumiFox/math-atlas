<mjx-c class=\"mjx-c2F\"></mjx-c></mjx-mo></mjx-TeXAtom><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D6FF TEX-I\"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\" symmetric=\"true\">‖</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">X</mi></mrow><mo data-mjx-texclass=\"CLOSE\" symmetric=\"true\">‖</mo></mrow><mi>F</mi></msub><mo>≤</mo><msub><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\" symmetric=\"true\">‖</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">C</mi></mrow><mo data-mjx-texclass=\"CLOSE\" symmetric=\"true\">‖</mo></mrow><mi>F</mi></msub><mrow data-mjx-texclass=\"ORD\"><mo>/</mo></mrow><mi>δ</mi></math></mjx-assistive-mml></mjx-container></span>.</p>","file":"ch20-perturbation/07-sylvester-bounds.html"}