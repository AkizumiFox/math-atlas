=\"false\">[</mo><mi>t</mi><mrow data-mjx-texclass=\"ORD\"><mo>/</mo></mrow><mi>x</mi><mo stretchy=\"false\">]</mo><mo>=</mo><mi>y</mi><mtext> </mtext><mtext> for a variable </mtext><mi>y</mi><mo>≠</mo><mi>x</mi><mo>,</mo><mstyle scriptlevel=\"0\"><mspace width=\"2em\"></mspace></mstyle><mi>c</mi><mo stretchy=\"false\">[</mo><mi>t</mi><mrow data-mjx-texclass=\"ORD\"><mo>/</mo></mrow><mi>x</mi><mo stretchy=\"false\">]</mo><mo>=</mo><mi>c</mi><mo>,</mo></mtd></mtr><mtr><mtd><mi>f</mi><mo stretchy=\"false\">(</mo><msub><mi>s</mi><mn>1</mn></msub><mo>,</mo><mo>…</mo><mo>,</mo><msub><mi>s</mi><mi>n</mi></msub><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">[</mo><mi>t</mi><mrow data-mjx-texclass=\"ORD\"><mo>/</mo></mrow><mi>x</mi><mo stretchy=\"false\">]</mo></mtd><mtd><mi></mi><mo>=</mo><mi>f</mi><mrow data-mjx-texclass=\"OPEN\"><mo minsize=\"1.2em\" maxsize=\"1.2em\">(</mo></mrow><msub><mi>s</mi><mn>1</mn></msub><mo stretchy=\"false\">[</mo><mi>t</mi><mrow data-mjx-texclass=\"ORD\"><mo>/</mo></mrow><mi>x</mi><mo stretchy=\"false\">]</mo><mo>,</mo><mo>…</mo><mo>,</mo><msub><mi>s</mi><mi>n</mi></msub><mo stretchy=\"false\">[</mo><mi>t</mi><mrow data-mjx-texclass=\"ORD\"><mo>/</mo></mrow><mi>x</mi><mo stretchy=\"false\">]</mo><mrow data-mjx-texclass=\"CLOSE\"><mo minsize=\"1.2em\" maxsize=\"1.2em\">)</mo></mrow><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></span> For a formula <span class=\"math inline\"><mjx-container class=\"MathJax\" jax=\"CHTML\" style=\"font-size: 113.1%; position: relative;\" data-tex=\"\\varphi\"><mjx-math class=\" MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D711 TEX-I\"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>φ</mi></math></mjx-assistive-mml></mjx-container></span>,\nthe formula <span class=\"math inline\"><mjx-container class=\"MathJax\" jax=\"CHTML\" style=\"font-size: 113.1%; posit