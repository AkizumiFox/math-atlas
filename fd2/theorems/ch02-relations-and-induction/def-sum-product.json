.15em;\"><mjx-mi class=\"mjx-i\" size=\"s\"><mjx-c class=\"mjx-c1D458 TEX-I\"></mjx-c></mjx-mi></mjx-script></mjx-msub></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><munderover><mo data-mjx-texclass=\"OP\">∏</mo><mrow data-mjx-texclass=\"ORD\"><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mrow data-mjx-texclass=\"ORD\"><mi>n</mi></mrow></munderover><msub><mi>a</mi><mi>k</mi></msub></math></mjx-assistive-mml></mjx-container></span>, for <span class=\"math inline\"><mjx-container class=\"MathJax\" jax=\"CHTML\" style=\"font-size: 113.1%; position: relative;\" data-tex=\"n \\in \\mathbb{N}\"><mjx-math class=\" MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D45B TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c2208\"></mjx-c></mjx-mo><mjx-TeXAtom space=\"4\" texclass=\"ORD\"><mjx-mi class=\"mjx-ds mjx-b\"><mjx-c class=\"mjx-c2115 TEX-A\"></mjx-c></mjx-mi></mjx-TeXAtom></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>n</mi><mo>∈</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"double-struck\">N</mi></mrow></math></mjx-assistive-mml></mjx-container></span>, are\ndefined by recursion: <span class=\"math display\"><mjx-container class=\"MathJax\" jax=\"CHTML\" style=\"font-size: 113.1%; position: relative;\" display=\"true\" data-tex=\"\n\\begin{aligned}\n\\sum_{k=1}^{0} a_k &\\mathrel{:=} 0, & \\sum_{k=1}^{n+1} a_k\n&\\mathrel{:=} \\sum_{k=1}^{n} a_k + a_{n+1}, \\\\\n\\prod_{k=1}^{0} a_k &\\mathrel{:=} 1, & \\prod_{k=1}^{n+1} a_k\n&\\mathrel{:=} \\Bigl(\\prod_{k=1}^{n} a_k\\Bigr) a_{n+1}.\n\\end{aligned}\n\"><mjx-math display=\"true\" style=\"margin-left: 0; margin-right: 0;\" class=\" MJX-TEX\" aria-hidden=\"true\"><mjx-mtable style=\"min-width: 17.381em;\"><mjx-table><mjx-itable><mjx-mtr><mjx-mtd style=\"text-align: right; padding-right: 0; padding-bottom: 0.15em;\"><